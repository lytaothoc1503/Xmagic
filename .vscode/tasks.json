{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Install project dependencies",
      "type": "shell",
      "command": "npm ci",
      "options": {
        "cwd": "${workspaceFolder}/project"
      },
      "inAgents": true,
      "runOptions": {
        "runOn": "worktreeCreated"
      }
    },
    {
      "label": "Start project",
      "type": "shell",
      "command": "npm start",
      "options": {
        "cwd": "${workspaceFolder}/project"
      },
      "problemMatcher": [],
      "inAgents": true
    }
  ]
}
